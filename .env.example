# PKM Workflow - Environment Configuration Template
# 1. Copy this file to .env
# 2. Fill in your local values
# 3. Never commit .env

# Absolute path to your Obsidian Vault
OBSIDIAN_VAULT_PATH=D:/your/path/to/Obsidian

# Obsidian Local REST API (optional unless write_mode=api/both)
OBSIDIAN_API_BASE=http://localhost:27123
# Keep empty if you prefer reading key from plugin data.json at runtime.
OBSIDIAN_API_KEY=

# Feed cache and retention settings
FEED_CACHE_EXPIRY_DAYS=7
RAW_FEED_KEEP_DAYS=7

# Daily schedule time (HH:MM)
DAILY_FETCH_TIME=07:00
