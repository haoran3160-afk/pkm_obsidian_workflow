# PKM Workflow — Environment Configuration Template
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values below
# 3. NEVER commit .env to git (it's already in .gitignore)

# ── Obsidian Vault ─────────────────────────────────────────────────────────────
# Absolute path to your Obsidian Vault folder
OBSIDIAN_VAULT_PATH=D:/your/path/to/Obsidian

# ── Obsidian Local REST API (optional) ────────────────────────────────────────
# Required only for pkm_bridge.py (REST API write mode)
# Plugin: https://github.com/coddingtonbear/obsidian-local-rest-api
OBSIDIAN_API_BASE=http://localhost:27123
OBSIDIAN_API_KEY=your_api_key_from_obsidian_plugin

# ── Feed Settings ─────────────────────────────────────────────────────────────
# How many days before cached article GUIDs expire (avoids duplicate notes)
FEED_CACHE_EXPIRY_DAYS=7
# How many days of raw daily feed files to keep before auto-archiving
RAW_FEED_KEEP_DAYS=7

# ── Scheduling ────────────────────────────────────────────────────────────────
# Time to auto-fetch daily when using --schedule mode (24-hour format)
DAILY_FETCH_TIME=07:00
